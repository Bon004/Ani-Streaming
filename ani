|g; s|"||g' | sort -n -k 1
}

# ANILIST

anilist_load_token() {
    [ -f "$anilist_token_file" ] && anilist_token="$(cat "$anilist_token_file")"
}

anilist_login() {
    [ -z "$anilist_client_id" ] && die "Set ANI_CLI_ANILIST_CLIENT_ID to your AniList client ID first."
    auth_url="https://anilist.co/api/v2/oauth/authorize?client_id=${anilist_client_id}&response_type=token"
    printf "\033[1;34mOpen this URL in your browser:\033[0m\n%s\n\n" "$auth_url"
    printf "AniList will display your access token on that page. Paste it here: "
    read -r anilist_token
    [ -z "$anilist_token" ] && die "No token entered."
    mkdir -p "$anilist_config_dir"
    printf "%s" "$anilist_token" >"$anilist_token_file"
    chmod 600 "$anilist_token_file"
    printf "\033[1;32mToken saved. Verifying with AniList...\033[0m\n"
    anilist_get_user_id
    exit 0
}

anilist_query() {
    curl -s -X POST "https://graphql.anilist.co" \
        -H "Content-Type: application/json" \
        -H "Accept: application/json" \
        -H "Authorization: Bearer $anilist_token" \
        --data "$1"
}

anilist_get_user_id() {
    _resp=$(anilist_query '{"query":"{ Viewer { id name } }"}')
    _uid=$(printf "%s" "$_resp" | jq -r '.data.Viewer.id // empty')
    [ -z "$_uid" ] && die "AniList: token invalid or expired. Run --anilist-login again."
    printf "%s" "$_uid" >"$anilist_user_id_file"
    _name=$(printf "%s" "$_resp" | jq -r '.data.Viewer.name // "unknown"')
    printf "\033[1;32mLogged in to AniList as: %s\033[0m\n" "$_name"
}

anilist_get_media_id() {
    _cache="$anilist_cache_dir/id_cache"
    [ -f "$_cache" ] && _cached=$(grep -m1 "^${id}	" "$_cache" | cut -f2)
    [ -n "$_cached" ] && printf "%s" "$_cached" && return 0
    _clean=$(printf "%s" "$1" | sed 's/"/\\"/g')
    _resp=$(anilist_query "{\"query\":\"{ Page { media(search: \\\"${_clean}\\\", type: ANIME) { id } } }\"}")
    _mid=$(printf "%s" "$_resp" | jq -r '.data.Page.media[0].id // empty')
    [ -z "$_mid" ] && return 1
    mkdir -p "$anilist_cache_dir"
    printf "%s\t%s\n" "$id" "$_mid" >>"$_cache"
    printf "%s" "$_mid"
}

anilist_sync_progress() {
    [ -z "$anilist_token" ] && return 0
    [ -z "$1" ] && return 0
    if [ -n "$_pct" ] && [ "$_pct" -lt 10 ] 2>/dev/null; then
        printf "\033[1;33mAniList: watched %s%%, skipping sync (need >10%%)\033[0m\n" "$_pct" 1>&2
        return 0
    fi
    _status="CURRENT"
    [ -n "$latest_ep" ] && [ "$ep_no" = "$latest_ep" ] && _status="COMPLETED"
    _mut="{\"query\":\"mutation { SaveMediaListEntry(mediaId: $1, progress: ${ep_no}, status: ${_status}) { id } }\"}"
    _res=$(anilist_query "$_mut" | jq -r '.data.SaveMediaListEntry.id // empty')
    [ -n "$_res" ] && printf "\033[1;32mAniList synced: ep %s [%s]\033[0m\n" "$ep_no" "$_status" 1>&2
}

anilist_get_watching_list() {
    [ -z "$anilist_token" ] && return 0
    [ ! -f "$anilist_user_id_file" ] && return 0
    _uid=$(cat "$anilist_user_id_file")
    _cache="$anilist_cache_dir/id_cache"
    [ ! -f "$_cache" ] && return 0
    _q="{\"query\":\"{ MediaListCollection(userId: ${_uid}, type: ANIME, status: CURRENT) { lists { entries { mediaId progress media { title { romaji } episodes } } } } }\"}"
    anilist_query "$_q" | jq -r '
        .data.MediaListCollection.lists[].entries[] |
        [(.mediaId|tostring), .media.title.romaji, ((.media.episodes//"?")|tostring), ((.progress+1)|tostring)] |
        @tsv' |
        while IFS='	' read -r _al_id _al_title _al_eps _al_next; do
            _ani_id=$(grep "	${_al_id}$" "$_cache" | head -1 | cut -f1)
            [ -n "$_ani_id" ] && printf "%s\t%s (%s episodes) - episode %s\n" "$_ani_id" "$_al_title" "$_al_eps" "$_al_next"
        done
}

anilist_write_preview_script() {
    # $1 = path to data file containing raw anime_list (allanime_id\ttitle lines)
    mkdir -p "$anilist_cache_dir"
    _ps="$anilist_cache_dir/preview.sh"
    _thumb_dir_win="$(cygpath -w "$anilist_cache_dir/thumbnails" 2>/dev/null)"
    printf '#!/bin/bash\nCACHE_DIR="%s"\nDATA_FILE="%s"\nTHUMB_DIR_WIN="%s"\n' \
        "$anilist_cache_dir" "$1" "$_thumb_dir_win" >"$_ps"
    cat >>"$_ps" <<'PREVIEW_SCRIPT_EOF'
# $1 = line number from fzf {1} — avoids shell-quoting issues with special chars in titles
LINE_NUM="$1"
[ -z "$LINE_NUM" ] && exit 0
TITLE=$(sed -n "${LINE_NUM}p" "$DATA_FILE" | cut -f2 | sed 's/ ([0-9]* episodes)$//')
[ -z "$TITLE" ] && exit 0
KEY=$(printf "%s" "$TITLE" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g' | cut -c1-80)
THUMB_DIR="$CACHE_DIR/thumbnails"
mkdir -p "$THUMB_DIR"
INFO_FILE="$THUMB_DIR/${KEY}.json"
IMG_FILE="$THUMB_DIR/${KEY}.jpg"
if [ ! -f "$INFO_FILE" ]; then
    CLEAN=$(printf "%s" "$TITLE" | sed 's/"/\\"/g')
    RESP=$(curl -s -m 5 -X POST "https://graphql.anilist.co" \
        -H "Content-Type: application/json" \
        -H "Accept: application/json" \
        --data "{\"query\":\"{ Page(perPage:1) { media(search:\\\"${CLEAN}\\\",type:ANIME) { title{romaji} coverImage{large} averageScore status episodes } } }\"}" 2>/dev/null)
    [ -n "$RESP" ] && printf "%s" "$RESP" > "$INFO_FILE"
fi
if [ -f "$INFO_FILE" ]; then
    IMG_URL=$(sed -nE 's|.*"large":"([^"]*)".*|\1|p' "$INFO_FILE" | head -1 | sed 's|[\\]/|/|g; s|[\\]u002F|/|g')
    SCORE=$(sed -nE 's|.*"averageScore":([0-9]+).*|\1|p' "$INFO_FILE" | head -1)
    STATUS=$(sed -nE 's|.*"status":"([^"]*)".*|\1|p' "$INFO_FILE" | head -1)
    EPISODES=$(sed -nE 's|.*"episodes":([0-9]+).*|\1|p' "$INFO_FILE" | head -1)
    ROM_TITLE=$(sed -nE 's|.*"romaji":"([^"]*)".*|\1|p' "$INFO_FILE" | head -1)
    [ -n "$IMG_URL" ] && [ ! -f "$IMG_FILE" ] && \
        curl -s -m 10 "$IMG_URL" -o "$IMG_FILE" 2>/dev/null
    [ -f "$IMG_FILE" ] && printf "%s\\%s.jpg" "$THUMB_DIR_WIN" "$KEY" > "${CACHE_DIR}/current_preview"
    printf "\n"
    [ -n "$ROM_TITLE" ] && printf "\033[1;36m%s\033[0m\n"            "$ROM_TITLE"
    [ -n "$SCORE" ]     && printf "\033[1;33mScore:\033[0m %s/100\n" "$SCORE"
    [ -n "$STATUS" ]    && printf "\033[1;32mStatus:\033[0m %s\n"    "$STATUS"
    [ -n "$EPISODES" ]  && printf "\033[1;35mEpisodes:\033[0m %s\n"  "$EPISODES"
fi
PREVIEW_SCRIPT_EOF
    chmod +x "$_ps"
    printf "%s" "$_ps"
}

anilist_write_preview_window_script() {
    _ps1="$anilist_cache_dir/preview_window.ps1"
    cat >"$_ps1" <<'PS1_WINDOW_EOF'
param([string]$WatchFile)
Add-Type -AssemblyName PresentationFramework
$xaml = '<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Title="Anime Cover" Width="310" Height="440" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Background="#0d0d0d" ResizeMode="CanResize"><Grid><Image Name="img" Stretch="Uniform" StretchDirection="Both"/></Grid></Window>'
$window = [Windows.Markup.XamlReader]::Parse($xaml)
$imgCtrl = $window.FindName("img")
$script:lastPath = ""
$timer = New-Object System.Windows.Threading.DispatcherTimer
$timer.Interval = [TimeSpan]::FromMilliseconds(400)
$timer.Add_Tick({
    if (-not (Test-Path $WatchFile)) { $window.Close(); return }
    try { $p = [System.IO.File]::ReadAllText($WatchFile).Trim() } catch { return }
    if (-not $p -or $p -eq $script:lastPath) { return }
    if (-not (Test-Path $p)) { return }
