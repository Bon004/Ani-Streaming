select_quality() {
    # removing urls which have referrer to avoid playing on iSH and vlc (m3u8 streams don't get correct referrer)
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android_vlc|iSH|vlc)' && links=$(printf '%s' "$links" | sed '/m3u8_refr >/d')
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android_vlc|iSH)' && links=$(printf '%s' "$links" | sed '/Yt >/d')
    case "$1" in
        best) result=$(printf "%s" "$links" | head -n1) ;;
        worst) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n1) ;;
        *) result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$result" ] && printf "Specified quality not found, defaulting to best\n" 1>&2 && result=$(printf "%s" "$links" | head -n1)

    # add refr for m3u8 and refr flag for yt
    case "$result" in
        *mp4upload*)
            refr_flag="--referrer=https://www.mp4upload.com"
            ;;
        *sharepoint*)
            unset refr_flag
            ;;
        *)
            refr_flag="--referrer=$allanime_refr"
            ;;
    esac

    episode=$(printf "%s" "$result" | cut -d'>' -f2)
}

process_response() {
    if ! printf '%s' "$1" | grep -q '"tobeparsed"'; then
        printf '%s' "$1"
        return 0
    fi

    tmp="$(mktemp)"
    printf '%s' "$1" | sed -nE 's|.*"tobeparsed":"([^"]*)".*|\1|p' | base64 -d >"$tmp"
    file_size="$(wc -c <"$tmp")"
    iv="$(dd if="$tmp" bs=1 skip=1 count=12 2>/dev/null | od -A n -t x1 | tr -d ' \n')"
    ctr="${iv}00000002"
    ct_len=$((file_size - 13 - 16))
    dd if="$tmp" bs=1 skip=13 count="$ct_len" 2>/dev/null | openssl enc -d -aes-256-ctr -K "$allanime_key" -iv "$ctr" -nosalt -nopad 2>/dev/null
    rm -f "$tmp"
}

decode_tobeparsed() {
    tmp="$(mktemp)"
    printf '%s' "$1" | base64 -d >"$tmp"
    file_size="$(wc -c <"$tmp")"
    iv="$(dd if="$tmp" bs=1 skip=1 count=12 2>/dev/null | od -A n -t x1 | tr -d ' \n')"
    ctr="${iv}00000002"
    ct_len=$((file_size - 13 - 16))
    plain="$(dd if="$tmp" bs=1 skip=13 count="$ct_len" 2>/dev/null | openssl enc -d -aes-256-ctr -K "$allanime_key" -iv "$ctr" -nosalt -nopad 2>/dev/null)"
    rm -f "$tmp"
    printf '%s' "$plain" | tr '{}' '\n' | sed -nE 's|.*"sourceUrl":"([^"]*)".*"sourceName":"([^"]*)".*|\2 :\1|p'
    _yt_url=$(printf '%s' "$plain" | tr '{}' '\n' | sed -nE 's|.*"sourceUrl":"(https://tools\.fast4speed\.rsvp[^"]*)".*|\1|p' | head -1)
    [ -n "$_yt_url" ] && printf 'Yt >%s\n' "$_yt_url"
}

# Fetches the rotating crypto material and derives the AES key.
# The key is split: partB rotates ~every 3 days (served in mkissa.to's SSR
# __aaCrypto blob), mask is baked into a JS chunk (changes on site redeploy).
# key = partB XOR mask. Result is cached for $aa_crypto_ttl seconds.
get_crypto() {
    # env-pinned values win and skip the fetch entirely
    [ -n "$ANI_CLI_AA_KEY" ] && [ -n "$ANI_CLI_AA_EPOCH" ] &&
        allanime_key="$ANI_CLI_AA_KEY" && allanime_aa_epoch="$ANI_CLI_AA_EPOCH" && return

    if [ -f "$aa_crypto_cache" ]; then
        . "$aa_crypto_cache"
        [ -n "$AA_CRYPTO_TIME" ] && [ "$(($(date +%s) - AA_CRYPTO_TIME))" -lt "$aa_crypto_ttl" ] &&
            allanime_key="$AA_CRYPTO_KEY" && allanime_aa_epoch="$AA_CRYPTO_EPOCH" && return
    fi

    _html="$(curl -sL -m 15 "$allanime_crypto_src" -A "$agent")"
    _crypto="$(printf '%s' "$_html" | sed -nE 's/.*window\.__aaCrypto[[:space:]]*=[[:space:]]*(\{[^;]+\});.*/\1/p')"
    _epoch="$(printf '%s' "$_crypto" | sed -nE 's/.*"epoch"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p')"
    _partB="$(printf '%s' "$_crypto" | sed -nE 's/.*"partB"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p')"
    { [ -z "$_epoch" ] || [ -z "$_partB" ]; } &&
        die "could not read __aaCrypto from ${allanime_crypto_src} (site layout changed?)"

    # the key mask lives as a bare 64-hex literal inside the JS chunk that also
    # references __aaCrypto; find that chunk by walking app.js's imports
    _app_js="$(printf '%s' "$_html" | sed -nE 's|.*import\("(https://[^"]*/entry/app\.[^"]*\.js)"\).*|\1|p' | head -1)"
    [ -z "$_app_js" ] && die "could not find app.js on ${allanime_crypto_src} (site layout changed?)"
    _chunk_base="${_app_js%/entry/*}/chunks"
    _mask=""
    for _c in $(curl -sL -m 15 "$_app_js" -A "$agent" | grep -oE '\.\./chunks/[A-Za-z0-9._-]+\.js' | sed 's|.*/||' | sort -u); do
        _js="$(curl -sL -m 15 "${_chunk_base}/${_c}" -A "$agent")"
        printf '%s' "$_js" | grep -q '__aaCrypto' || continue
        _mask="$(printf '%s' "$_js" | grep -oE '"[a-f0-9]{64}"' | head -1 | tr -d '"')"
        [ -n "$_mask" ] && break
    done
    [ -z "$_mask" ] && die "could not find crypto mask in mkissa chunks (site changed?)"

    _partB_hex="$(printf '%s' "$_partB" | tr -- '-_' '+/' | base64 -d | od -A n -t x1 | tr -d ' \n')"
    _key=""
    _i=0
    while [ "$_i" -lt 64 ]; do
        _key="${_key}$(printf '%02x' "$((0x${_mask:$_i:2} ^ 0x${_partB_hex:$_i:2}))")"
        _i=$((_i + 2))
    done

    allanime_key="$_key"
    allanime_aa_epoch="$_epoch"
    mkdir -p "$(dirname "$aa_crypto_cache")"
    printf 'AA_CRYPTO_EPOCH=%s\nAA_CRYPTO_KEY=%s\nAA_CRYPTO_TIME=%s\n' \
        "$_epoch" "$_key" "$(date +%s)" >"$aa_crypto_cache"
}

# builds the encrypted aaReq token AllAnime now requires on episode queries
# (AES-256-GCM via node — botan isn't available on Windows/scoop)
get_aa_req() {
    node -e '
const crypto = require("crypto");
const [keyHex, epochStr, buildId, qh] = process.argv.slice(1);
const key = Buffer.from(keyHex, "hex");
const epoch = parseInt(epochStr, 10);
const ts = Math.floor(Date.now() / 1000 / 300) * 300 * 1000;
const iv = crypto.createHash("sha256").update(`${epoch}:${buildId}:${qh}:${ts}`).digest().subarray(0, 12);
const payload = JSON.stringify({ v: 1, ts, epoch, buildId, qh });
const c = crypto.createCipheriv("aes-256-gcm", key, iv);
const ct = Buffer.concat([c.update(payload, "utf8"), c.final()]);
process.stdout.write(Buffer.concat([Buffer.from([1]), iv, ct, c.getAuthTag()]).toString("base64"));
' "$allanime_key" "$allanime_aa_epoch" "$allanime_aa_build" "$allanime_query_hash"
}

b64url_to_hex() {
    _len=$(printf '%s' "$1" | wc -c | tr -d ' ')
    _mod=$((_len % 4))
    case $_mod in
        2) _pad="==" ;;
        3) _pad="=" ;;
        *) _pad="" ;;
    esac
    printf '%s%s' "$1" "$_pad" | tr -- '-_' '+/' | base64 -d | od -A n -t x1 | tr -d ' \n'
}

get_filemoon_links() {
    response="$(curl -e "$allanime_refr" -s -m 8 "https://${allanime_base}$1" -A "$agent")"
    _fm_json="$(printf '%s' "$response" | tr -d '\n ' | tr ',' '\n')"
    iv="$(printf '%s' "$_fm_json" | sed -nE 's|^"iv":"([^"]*)"$|\1|p')"
    payload="$(printf '%s' "$_fm_json" | sed -nE 's|^"payload":"([^"]*)"$|\1|p')"
    kp1="$(printf '%s' "$_fm_json" | sed -nE 's|^"key_parts":\["([^"]*)"$|\1|p')"
    kp2="$(printf '%s' "$_fm_json" | sed -nE 's|^"([A-Za-z0-9_-]+)"\]$|\1|p' | head -1)"
    _kp1_hex="$(b64url_to_hex "$kp1")"
    _kp2_hex="$(b64url_to_hex "$kp2")"
    key_hex="$_kp1_hex$_kp2_hex"
    iv_hex="$(b64url_to_hex "$iv")00000002"
    tmp="$(mktemp)"
    _fm_len=$(printf '%s' "$payload" | wc -c | tr -d ' ')
    _fm_mod=$((_fm_len % 4))
    case $_fm_mod in
        2) _fm_pad="==" ;;
        3) _fm_pad="=" ;;
        *) _fm_pad="" ;;
    esac
    printf '%s%s' "$payload" "$_fm_pad" | tr -- '-_' '+/' | base64 -d >"$tmp"
    ct_len=$(($(wc -c <"$tmp") - 16))
    plain="$(dd if="$tmp" bs=1 count="$ct_len" 2>/dev/null | openssl enc -d -aes-256-ctr -K "$key_hex" -iv "$iv_hex" -nosalt -nopad 2>/dev/null)"
    rm -f "$tmp"
    printf '%s' "$plain" | tr '{}[]' '\n' |
        sed -nE 's|.*"url":"([^"]*)".*"height":([0-9]+).*|\2 >\1|p;s|.*"height":([0-9]+).*"url":"([^"]*)".*|\1 >\2|p' |
        sed 's|\\u0026|\&|g;s|\\u003D|=|g' | sort -rn
    printf "\033[1;32m%s\033[0m Links Fetched\n" "Filemoon" 1>&2
}

# gets embed urls, collects direct links into provider files, selects one with desired quality into $episode
get_episode_url() {
    get_crypto
    query_vars="{\"showId\":\"$id\",\"translationType\":\"$mode\",\"episodeString\":\"$ep_no\"}"
    query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$allanime_query_hash\"}, \"aaReq\":\"$(get_aa_req)\"}"

    api_resp="$(curl -e "$allanime_refr" -sG -m 10 -A "$agent" -H "Origin: ${allanime_refr}" -H "x-build-id: ${allanime_aa_build}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"

    # a stale cached key can outlive an epoch rotation; bust it and retry once
    if printf "%s" "$api_resp" | grep -q 'AA_CRYPTO'; then
        rm -f "$aa_crypto_cache"
        get_crypto
        query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$allanime_query_hash\"}, \"aaReq\":\"$(get_aa_req)\"}"
        api_resp="$(curl -e "$allanime_refr" -sG -m 10 -A "$agent" -H "Origin: ${allanime_refr}" -H "x-build-id: ${allanime_aa_build}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"
        printf "%s" "$api_resp" | grep -q 'AA_CRYPTO' &&
            die "mkissa rejected the aaReq token even after refreshing the key. The buildId (${allanime_aa_build}) or crypto scheme likely changed — check upstream ani-cli / stl3's fork."
    fi

    if printf "%s" "$api_resp" | grep -q '"tobeparsed"'; then
        blob="$(printf "%s" "$api_resp" | sed -nE 's|.*"tobeparsed":"([^"]*)".*|\1|p')"
        resp="$(decode_tobeparsed "$blob")"
    else
        resp="$(printf "%s" "$api_resp" | tr '{}' '\n' | sed 's|\\u002F|\/|g;s|\\||g' | sed -nE 's|.*sourceUrl":"([^"]*)".*sourceName":"([^"]*)".*|\2 :\1|p')"
    fi
    _direct_links=$(printf '%s' "$resp" | grep '^Yt >')
    resp=$(printf '%s' "$resp" | grep -v '^Yt >')
    cache_dir="$(mktemp -d)"
    [ -n "$_direct_links" ] && printf '%s\n' "$_direct_links" >"$cache_dir/yt"
    providers="1 2 3 4 5 6"
    provider_pids=""
    for provider in $providers; do
        generate_link "$provider" >"$cache_dir"/"$provider" &
        provider_pids="$provider_pids $!"
    done
    # exit as soon as any provider returns a valid result
    while true; do
        for f in "$cache_dir"/*; do
            [ -s "$f" ] && break 2
        done
        all_done=1
        for pid in $provider_pids; do
            kill -0 "$pid" 2>/dev/null && {
                all_done=0
                break
            }
        done
        [ "$all_done" = "1" ] && break
        sleep 0.1
    done
    for pid in $provider_pids; do kill "$pid" 2>/dev/null; done
    wait
    # select the link with matching quality
    links=$(cat "$cache_dir"/* | sort -g -r -s)
    rm -r "$cache_dir"
    select_quality "$quality"
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$episode" ] && die "Episode is released, but no valid sources!"
    else
        [ -z "$episode" ] && die "Episode not released!"
    fi
}

diagnose_episode() {
    printf "\033[1;36m[DIAG] === anistream provider diagnosis ===\033[0m\n"
    printf "\033[1;36m[DIAG] Show: %s | Episode: %s | Mode: %s\033[0m\n" "$id" "$ep_no" "$mode"

    get_crypto
    query_vars="{\"showId\":\"$id\",\"translationType\":\"$mode\",\"episodeString\":\"$ep_no\"}"
    query_ext="{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$allanime_query_hash\"}, \"aaReq\":\"$(get_aa_req)\"}"
    printf "\033[1;36m[DIAG] Fetching episode sources from API (GET with aaReq token, epoch=%s build=%s)...\033[0m\n" "$allanime_aa_epoch" "$allanime_aa_build"
    api_resp="$(curl -e "$allanime_refr" -sG -m 15 -A "$agent" -H "Origin: ${allanime_refr}" -H "x-build-id: ${allanime_aa_build}" "${allanime_api}/api" --data-urlencode "variables=${query_vars}" --data-urlencode "extensions=${query_ext}")"

    _aa_err="$(printf '%s' "$api_resp" | sed -nE 's|.*"code":"(AA_CRYPTO[A-Z_]*)".*|\1|p')"
    if [ -n "$_aa_err" ]; then
        printf "\033[1;31m[DIAG] API rejected the aaReq token: %s\033[0m\n" "$_aa_err"
        printf "\033[1;31m[DIAG] Try 'rm -f %s' to force a fresh key; if it persists the buildId/scheme changed\033[0m\n" "$aa_crypto_cache"
        return 1
    fi

    if [ -z "$api_resp" ]; then
        printf "\033[1;31m[DIAG] API returned empty response — network issue or API down\033[0m\n"
        return 1
    fi

    if printf "%s" "$api_resp" | grep -q '"tobeparsed"'; then
        printf "\033[1;33m[DIAG] Response type: tobeparsed (AES-256-CTR encrypted)\033[0m\n"
        blob="$(printf "%s" "$api_resp" | sed -nE 's|.*"tobeparsed":"([^"]*)".*|\1|p')"
        resp="$(decode_tobeparsed "$blob")"
    elif printf "%s" "$api_resp" | grep -q '"sourceUrl"'; then
        printf "\033[1;33m[DIAG] Response type: plain sourceUrls\033[0m\n"
        resp="$(printf "%s" "$api_resp" | tr '{}' '\n' | sed 's|\\u002F|\/|g;s|\\||g' | sed -nE 's|.*sourceUrl":"([^"]*)".*sourceName":"([^"]*)".*|\2 :\1|p')"
    else
        printf "\033[1;31m[DIAG] API response has no sourceUrls or tobeparsed:\033[0m\n%s\n" "$(printf '%s' "$api_resp" | head -c 400 || true)"
        return 1
    fi

    if [ -z "$resp" ]; then
        printf "\033[1;31m[DIAG] Provider list is empty after decoding — decryption may have failed\033[0m\n"
        return 1
    fi

    printf "\033[1;32m[DIAG] Providers offered by AllAnime for this episode:\033[0m\n"
    printf "%s\n" "$resp" | sed 's/ :.*//' | while read -r pname; do printf "  - %s\n" "$pname"; done

    printf "\n\033[1;36m[DIAG] Testing each provider CDN response...\033[0m\n"
    _diag_cache="$(mktemp -d)"
    for provider in 1 2 3 4 5 6; do
        generate_link "$provider" >"$_diag_cache/$provider" 2>/dev/null
        _out="$(cat "$_diag_cache/$provider")"
        if [ -n "$_out" ]; then
            printf "\033[1;32m[DIAG] Provider %s => links found:\033[0m\n%s\n\n" "$provider" "$_out"
        else
            printf "\033[1;31m[DIAG] Provider %s => empty (CDN timeout, pattern mismatch, or not offered)\033[0m\n" "$provider"
        fi
    done
    rm -r "$_diag_cache"
    printf "\n\033[1;36m[DIAG] Done. If all providers are empty, the CDN endpoints are returning\033[0m\n"
    printf "\033[1;36m[DIAG] responses that don't match any known format, or the CDN is down.\033[0m\n"
}

# MANGA

manga_search() {
    _resp=$(curl -sg -m 10 \
        "https://api.mangadex.org/manga?title=$1&limit=20&availableTranslatedLanguage[]=en&hasAvailableChapters=true&order[followedCount]=desc" \
        -H "Accept: application/json")
    printf "%s" "$_resp" | jq -r '.data[] | [
        .id,
        ((.attributes.title.en // (.attributes.title | to_entries[0].value)) + " (" + (.attributes.status // "?") + ")")
    ] | @tsv'
}

manga_chapters_list() {
    _all=""
    _offset=0
    while true; do
        _resp=$(curl -sg -m 15 \
            "https://api.mangadex.org/manga/$1/feed?translatedLanguage[]=en&order[chapter]=asc&limit=500&offset=${_offset}")
        _batch=$(printf "%s" "$_resp" | jq -r '.data[] | [
            .id,
            ((if .attributes.volume then "Vol." + .attributes.volume + " " else "" end) +
             "Ch." + (.attributes.chapter // "?") +
             (if .attributes.title and .attributes.title != "" then " - " + .attributes.title else "" end) +
             (if .attributes.externalUrl then " [ext]" else "" end)),
            (.attributes.externalUrl // "")
        ] | @tsv')
        _total=$(printf "%s" "$_resp" | jq -r '.total // 0')
        _all=$(printf "%s\n%s" "$_all" "$_batch" | sed '/^$/d')
        _offset=$((_offset + 500))
        [ "$_offset" -ge "$_total" ] && break
    done
    printf "%s\n" "$_all"
}

manga_get_page_urls() {
    _athome=$(curl -s -m 10 "https://api.mangadex.org/at-home/server/$1")
    _base=$(printf "%s" "$_athome" | jq -r '.baseUrl')
    _hash=$(printf "%s" "$_athome" | jq -r '.chapter.hash')
    printf "%s" "$_athome" | jq -r --arg b "$_base" --arg h "$_hash" \
        '.chapter.data[] | "\($b)/data/\($h)/\(.)"'
}

manga_read_chapter() {
    _chapter_id="$1"
    _title="$2"
    _ext_url="$3"
    if [ -n "$_ext_url" ]; then
        printf "\033[1;33mThis chapter is hosted externally.\033[0m\n"
        printf "\033[1;36mURL: %s\033[0m\n" "$_ext_url"
        printf "Opening in browser...\n"
        case "$(uname -s)" in
            MINGW* | MSYS* | CYGWIN*) explorer.exe "$_ext_url" 2>/dev/null ;;
            Darwin*) open "$_ext_url" 2>/dev/null ;;
            *) xdg-open "$_ext_url" 2>/dev/null ;;
        esac
        return 0
    fi
    printf "\033[1;34mFetching pages for %s...\033[0m\n" "$_title"
    _urls=$(manga_get_page_urls "$_chapter_id")
    [ -z "$_urls" ] && die "No pages found for this chapter."
    _total=$(printf "%s\n" "$_urls" | wc -l | tr -d ' ')
    _page_list=$(mktemp)
    printf "%s\n" "$_urls" >"$_page_list"
    _tmp_img=$(mktemp --suffix=.jpg)
    _page_num=1
    _quit=0
    while [ "$_quit" = "0" ]; do
        _url=$(sed -n "${_page_num}p" "$_page_list")
        [ -z "$_url" ] && break
        printf "\033[2J\033[H"
        printf "\033[1;34m%s  Page %s/%s  [Enter] next  [p] prev  [s] spread  [q] quit\033[0m\n" \
            "$_title" "$_page_num" "$_total"
        curl -s -m 30 "$_url" -o "$_tmp_img" 2>/dev/null
        chafa --symbols=all --colors=full --size="${COLUMNS:-80}x$((${LINES:-24} - 2))" "$_tmp_img" 2>/dev/null
        read -r _input
        case "$_input" in
            q | Q) _quit=1 ;;
            p | P) [ "$_page_num" -gt 1 ] && _page_num=$((_page_num - 1)) ;;
            s | S)
                _url_r=$(sed -n "$((_page_num + 1))p" "$_page_list")
                if [ -n "$_url_r" ]; then
                    _sl=$(mktemp --suffix=.jpg)
                    _sr=$(mktemp --suffix=.jpg)
                    _ltxt=$(mktemp)
                    _rtxt=$(mktemp)
                    curl -s -m 30 "$_url" -o "$_sl" 2>/dev/null
                    curl -s -m 30 "$_url_r" -o "$_sr" 2>/dev/null
                    printf "\033[2J\033[H"
                    printf "\033[1;34m%s  SPREAD %s+%s/%s  [Enter] advance past spread  [p] back  [q] quit\033[0m\n" \
                        "$_title" "$_page_num" "$((_page_num + 1))" "$_total"
                    chafa --symbols=all --colors=full --size="$((${COLUMNS:-80} / 2))x$((${LINES:-24} - 2))" "$_sl" >"$_ltxt" 2>/dev/null
                    chafa --symbols=all --colors=full --size="$((${COLUMNS:-80} / 2))x$((${LINES:-24} - 2))" "$_sr" >"$_rtxt" 2>/dev/null
                    paste "$_ltxt" "$_rtxt"
                    rm -f "$_sl" "$_sr" "$_ltxt" "$_rtxt"
                    read -r _si
                    case "$_si" in
                        q | Q) _quit=1 ;;
                        p | P) [ "$_page_num" -gt 1 ] && _page_num=$((_page_num - 1)) ;;
                        *) _page_num=$((_page_num + 2)) ;;
                    esac
                else
                    printf "\033[1;33mAlready at last page — no next page for spread.\033[0m\n"
                    sleep 1
                fi
                ;;
            *) _page_num=$((_page_num + 1)) ;;
        esac
    done
    rm -f "$_tmp_img" "$_page_list"
}

manga_update_history() {
    if grep -q "	$2	" "$manga_histfile"; then
        sed -E "s|^[^\t]+\t${2}\t.*$|${1}\t${2}\t${3}\t${4}|" "$manga_histfile" >"${manga_histfile}.new"
    else
        cp "$manga_histfile" "${manga_histfile}.new"
        printf "%s\t%s\t%s\t%s\n" "$1" "$2" "$3" "$4" >>"${manga_histfile}.new"
    fi
    mv "${manga_histfile}.new" "$manga_histfile"
}

anilist_get_manga_media_id() {
    [ -z "$anilist_token" ] && return 1
    _clean=$(printf "%s" "$1" | sed 's/"/\\"/g')
    _resp=$(anilist_query "{\"query\":\"{ Page { media(search: \\\"${_clean}\\\", type: MANGA) { id } } }\"}")
    printf "%s" "$_resp" | jq -r '.data.Page.media[0].id // empty'
}

anilist_sync_manga_progress() {
    [ -z "$anilist_token" ] && return 0
    [ -z "$1" ] || [ -z "$2" ] && return 0
    _ch_int=$(printf "%s" "$2" | grep -oE '[0-9]+' | head -1)
    [ -z "$_ch_int" ] && return 0
    _mut="{\"query\":\"mutation { SaveMediaListEntry(mediaId: $1, progress: ${_ch_int}, status: CURRENT) { id } }\"}"
    _res=$(anilist_query "$_mut" | jq -r '.data.SaveMediaListEntry.id // empty')
    [ -n "$_res" ] && printf "\033[1;32mAniList manga synced: Ch %s\033[0m\n" "$_ch_int" 1>&2
}

manga_main() {
    if [ "$search" = "history" ]; then
        [ ! -s "$manga_histfile" ] && die "No manga reading history!"
        _hist_display=$(sed 's/^[^	]*	\([^	]*	[^	]*\)	/\1 - /' "$manga_histfile")
        _result=$(printf "%s" "$_hist_display" | nl -w2 | sed 's/^[[:space:]]//' | nth "Select manga to continue: ")
        manga_id=$(printf "%s" "$_result" | cut -f1)
        manga_title=$(printf "%s" "$_result" | cut -f2 | sed 's/ - .*//')
        _last_chapter_id=$(grep "	${manga_id}	" "$manga_histfile" | cut -f1)
        printf "\033[1;34mFetching chapters...\033[0m\n"
        chapter_list=$(manga_chapters_list "$manga_id")
        [ -z "$chapter_list" ] && die "No English chapters found on MangaDex!"
        chapter_list_ids=$(printf "%s" "$chapter_list" | cut -f1)
        chapter_id=$(printf "%s\n" "$chapter_list_ids" | sed -n "/^${_last_chapter_id}$/{n;p;}" | head -1)
        [ -z "$chapter_id" ] && chapter_id=$(printf "%s\n" "$chapter_list_ids" | tail -1)
        chapter_display=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f2)
        chapter_ext_url=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f3)
    else
        while [ -z "$query" ]; do
            printf "\033[1;36mSearch manga: \033[0m" && read -r query
            query=$(printf "%s" "$query" | tr -d '\r')
        done
        query=$(printf "%s" "$query" | sed "s| |+|g")
        printf "\033[1;34mSearching MangaDex...\033[0m\n"
        manga_list=$(manga_search "$query")
        [ -z "$manga_list" ] && die "No manga found!"
        _result=$(printf "%s" "$manga_list" | nl -w2 | sed 's/^[[:space:]]//' | nth "Select manga: ")
        manga_id=$(printf "%s" "$_result" | cut -f1)
        manga_title=$(printf "%s" "$_result" | cut -f2)
        printf "\033[1;34mFetching chapters...\033[0m\n"
        chapter_list=$(manga_chapters_list "$manga_id")
        [ -z "$chapter_list" ] && die "No English chapters found on MangaDex!"
        chapter_list_ids=$(printf "%s" "$chapter_list" | cut -f1)
        chapter_result=$(printf "%s" "$chapter_list" | nl -w2 | sed 's/^[[:space:]]//' | nth "Select chapter: ")
        chapter_id=$(printf "%s" "$chapter_result" | cut -f1)
        chapter_display=$(printf "%s" "$chapter_result" | cut -f2)
        chapter_ext_url=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f3)
    fi
    _al_manga_id=$(anilist_get_manga_media_id "$manga_title" 2>/dev/null) || _al_manga_id=""
    manga_read_chapter "$chapter_id" "$chapter_display" "$chapter_ext_url"
    manga_update_history "$chapter_id" "$manga_id" "$manga_title" "$chapter_display"
    anilist_sync_manga_progress "$_al_manga_id" "$chapter_display"
    while cmd=$(printf "next\nprevious\nselect\nquit" | nth "Read $chapter_display of $manga_title... "); do
        case "$cmd" in
            next)
                _next_id=$(printf "%s\n" "$chapter_list_ids" | sed -n "/^${chapter_id}$/{n;p;}")
                if [ -z "$_next_id" ]; then
                    printf "\033[1;33mAlready at the last chapter.\033[0m\n"
                    continue
                fi
                chapter_id="$_next_id"
                chapter_display=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f2)
                chapter_ext_url=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f3)
                ;;
            previous)
                _prev_id=$(printf "%s\n" "$chapter_list_ids" | sed -n "/^${chapter_id}$/{g;1!p;};h")
                if [ -z "$_prev_id" ]; then
                    printf "\033[1;33mAlready at the first chapter.\033[0m\n"
                    continue
                fi
                chapter_id="$_prev_id"
                chapter_display=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f2)
                chapter_ext_url=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f3)
                ;;
            select)
                chapter_result=$(printf "%s" "$chapter_list" | nl -w2 | sed 's/^[[:space:]]//' | nth "Select chapter: ")
                chapter_id=$(printf "%s" "$chapter_result" | cut -f1)
                chapter_display=$(printf "%s" "$chapter_result" | cut -f2)
                chapter_ext_url=$(printf "%s" "$chapter_list" | grep "^${chapter_id}	" | cut -f3)
                ;;
            quit) break ;;
            *) ;;
        esac
        manga_read_chapter "$chapter_id" "$chapter_display" "$chapter_ext_url"
        manga_update_history "$chapter_id" "$manga_id" "$manga_title" "$chapter_display"
        anilist_sync_manga_progress "$_al_manga_id" "$chapter_display"
    done
}

# search the query and give results
search_anime() {
    #shellcheck disable=SC2016
    search_gql='query( $search: SearchInput $limit: Int $page: Int $translationType: VaildTranslationTypeEnumType $countryOrigin: VaildCountryOriginEnumType ) { shows( search: $search limit: $limit page: $page translationType: $translationType countryOrigin: $countryOrigin ) { edges { _id name availableEpisodes __typename } }}'

    curl -e "$allanime_refr" -s -H "Content-Type: application/json" -X POST "${allanime_api}/api" --data "{\"variables\":{\"search\":{\"allowAdult\":false,\"allowUnknown\":false,\"query\":\"$1\"},\"limit\":40,\"page\":1,\"translationType\":\"$mode\",\"countryOrigin\":\"ALL\"},\"query\":\"$search_gql\"}" -A "$agent" | sed 's|Show|\
| g' | sed -nE "s|.*_id\":\"([^\"]*)\",\"name\":\"(.+)\",.*${mode}\":([1-9][^,]*).*|\1	\2 (\3 episodes)|p" | sed 's/\\"//g'
}

time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    query="$(printf "%s\n" "$*" | tr ' ' '+')"
    curl -s -G "$animeschedule/api/v3/anime" --data "q=${query}" | sed 's|"id"|\n|g' | sed -nE 's|.*,"route":"([^"]*)","premier.*|\1|p' | while read -r anime; do
        data=$(curl -s "$animeschedule/anime/$anime" | sed '1,/"anime-header-list-buttons-wrapper"/d' | sed -nE 's|.*countdown-time-raw" datetime="([^"]*)">.*|Next Raw Release: \1|p;s|.*countdown-time" datetime="([^"]*)">.*|Next Sub Release: \1|p;s|.*english-title">([^<]*)<.*|English Title: \1|p;s|.*main-title".*>([^<]*)<.*|Japanese Title: \1|p')
        status="Ongoing"
        color="33"
        printf "%s\n" "$data"
        ! (printf "%s\n" "$data" | grep -q "Next Raw Release:") && status="Finished" && color="32"
        printf "Status:  \033[1;%sm%s\033[0m\n---\n" "$color" "$status"
    done
    exit 0
}

# get the episodes list of the selected anime
episodes_list() {
