#!/bin/sh

version_number="4.14.1"

# UI

external_menu() {
    [ "$use_external_menu" = "1" ] && rofi "$1" -sort -dmenu -i -width 1500 -p "$2" "$3"
    [ "$use_external_menu" = "2" ] && dmenu -l 20 -p "$2"
}

launcher() {
    [ "$use_external_menu" = "0" ] && [ -z "$1" ] && set -- "+m" "$2"
    if [ "$use_external_menu" = "0" ]; then
        if [ -n "$_ani_preview_script" ]; then
            _win_pid=""
            if [ -n "$_ani_preview_win_script" ] && command -v powershell.exe >/dev/null 2>&1; then
                _ps1_win="$(cygpath -w "$_ani_preview_win_script" 2>/dev/null)"
                _watch_win="$(cygpath -w "$anilist_cache_dir/current_preview" 2>/dev/null)"
                : >"$anilist_cache_dir/current_preview"
                powershell.exe -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass \
                    -File "$_ps1_win" \
                    -WatchFile "$_watch_win" \
                    </dev/null >/dev/null 2>&1 &
                _win_pid=$!
            fi
            fzf "$1" --reverse --cycle --prompt "$2" \
                --preview "bash \"$_ani_preview_script\" {1}" \
                --preview-window=right:35%:wrap
            [ -n "$_win_pid" ] && kill "$_win_pid" 2>/dev/null
            rm -f "$anilist_cache_dir/current_preview"
        else
            fzf "$1" --reverse --cycle --prompt "$2"
        fi
    fi
    [ "$use_external_menu" = "1" ] && external_menu "$1" "$2" "$external_menu_args"
    [ "$use_external_menu" = "2" ] && external_menu "$1" "$2"
}

nth() {
    stdin=$(cat -)
    [ -z "$stdin" ] && return 1
    line_count="$(printf "%s\n" "$stdin" | wc -l | tr -d "[:space:]")"
    [ "$line_count" -eq 1 ] && printf "%s" "$stdin" | cut -f2,3 && return 0
    prompt="$1"
    multi_flag=""
    [ $# -ne 1 ] && shift && multi_flag="$1"
    line=$(printf "%s" "$stdin" | cut -f1,3 | tr '\t' ' ' | launcher "$multi_flag" "$prompt" | cut -d " " -f 1)
    line_start=$(printf "%s" "$line" | head -n1)
    line_end=$(printf "%s" "$line" | tail -n1)
    [ -n "$line" ] || exit 1
    if [ "$line_start" = "$line_end" ]; then
        printf "%s" "$stdin" | grep -E '^'"${line}"'($|[[:space:]])' | cut -f2,3 || exit 1
    else
        printf "%s" "$stdin" | sed -n '/^'"${line_start}"'$/,/^'"${line_end}$"'/p' || exit 1
    fi
}

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

